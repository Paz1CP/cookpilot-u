<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".CookPilotApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CookPilot">

        <activity
            android:name=".features.auth.presentation.activity.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.CookPilot.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".features.auth.presentation.activity.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.CookPilot"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".features.cookmode.presentation.activity.CookModeActivity"
            android:exported="false"
            android:theme="@style/Theme.CookPilot"
            android:screenOrientation="sensorPortrait" />

        <activity
            android:name=".features.recipes.presentation.activity.RecipeDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.CookPilot"
            android:screenOrientation="sensorPortrait" />

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.CookPilot"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
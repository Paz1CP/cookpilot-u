<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cook_layer_base">

    <com.cookpilot.university.core.design.components.navigation.CookAppBarView
        android:id="@+id/appBar"
        android:layout_width="0dp"
        android:layout_height="@dimen/cook_app_bar_height"
        android:layout_marginStart="@dimen/cook_padding_screen_x"
        android:layout_marginTop="@dimen/cook_spacing_16"
        android:layout_marginEnd="@dimen/cook_padding_screen_x"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/mainContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/cook_spacing_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBar" />

    <com.cookpilot.university.core.design.components.navigation.CookBottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="@dimen/cook_bottom_nav_height"
        android:layout_marginStart="@dimen/cook_padding_screen_x"
        android:layout_marginEnd="@dimen/cook_padding_screen_x"
        android:layout_marginBottom="@dimen/cook_spacing_16"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/cook_layer_base">
    <androidx.fragment.app.FragmentContainerView android:id="@+id/mapSurface"
        android:layout_width="match_parent" android:layout_height="match_parent" />
    <LinearLayout android:id="@+id/mapHeader" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:padding="@dimen/cook_spacing_16">
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/mapBack"
            android:layout_width="@dimen/cook_touch_64" android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/cook_spacing_12" android:padding="@dimen/cook_spacing_20"
            android:minHeight="@dimen/cook_touch_64" android:scaleType="fitCenter"
            android:background="@drawable/bg_cookmap_header" app:tint="@color/cook_text_primary"
            android:contentDescription="@string/cookmap_back" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:minHeight="@dimen/cook_touch_64"
            android:orientation="vertical" android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/cook_spacing_16" android:paddingVertical="@dimen/cook_spacing_12"
            android:background="@drawable/bg_cookmap_header" android:elevation="4dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:includeFontPadding="false" android:text="@string/cookmap_title"
                android:textAppearance="@style/TextAppearance.CookPilot.TitleM" />
            <TextView android:id="@+id/mapSubtitle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/cook_spacing_4"
                android:includeFontPadding="false" android:text="@string/cookmap_subtitle"
                android:textColor="@color/cook_text_tertiary" android:textAppearance="@style/TextAppearance.CookPilot.MapBody" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/mapStatus" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_gravity="center"
        android:layout_margin="@dimen/cook_spacing_24" android:padding="@dimen/cook_spacing_24"
        android:orientation="vertical" android:background="@drawable/bg_cookmap_panel" android:elevation="8dp">
        <ImageView android:layout_width="@dimen/cook_icon_32" android:layout_height="@dimen/cook_icon_32"
            android:layout_marginBottom="@dimen/cook_spacing_16" android:src="@drawable/ic_cook_location"
            android:contentDescription="@null" app:tint="@color/cook_primary" />
        <TextView android:id="@+id/mapStatusText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite" android:includeFontPadding="false"
            android:lineSpacingExtra="@dimen/cook_spacing_4" android:text="@string/cookmap_loading"
            android:textAppearance="@style/TextAppearance.CookPilot.MapBody" />
        <com.google.android.material.button.MaterialButton android:id="@+id/mapPermission"
            style="@style/Widget.CookPilot.MapButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/cook_spacing_20"
            android:text="@string/cookmap_allow" />
        <com.google.android.material.button.MaterialButton android:id="@+id/mapDemo"
            style="@style/Widget.CookPilot.MapButton.Secondary" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/cook_spacing_12"
            android:text="@string/cookmap_example" />
        <com.google.android.material.button.MaterialButton android:id="@+id/mapRetry"
            style="@style/Widget.CookPilot.MapButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/cook_spacing_20"
            android:text="@string/cookmap_retry" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:id="@+id/mapActions" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/cook_spacing_16" android:orientation="vertical"
        android:gravity="end" android:visibility="gone">
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/mapFocusLocation" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginBottom="@dimen/cook_spacing_20"
            
            app:srcCompat="@drawable/ic_cook_location" app:tint="@color/cook_dark"
            app:backgroundTint="@color/cook_primary"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.CookPilot.Pill" />
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton android:id="@+id/mapPlaces"
        android:layout_width="wrap_content" android:layout_height="@dimen/cook_touch_56"
        android:text="@string/cookmap_places" android:textAppearance="@style/TextAppearance.CookPilot.Button"
        android:textColor="@color/cook_dark" app:backgroundTint="@color/cook_primary"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.CookPilot.Medium"
        app:icon="@drawable/ic_cook_location" app:iconTint="@color/cook_dark" />
    </LinearLayout>
    <LinearLayout android:id="@+id/placeSheet"
        android:orientation="vertical"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_marginTop="112dp" android:background="@drawable/bg_cookmap_sheet"
        android:visibility="invisible"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_hideable="true" app:behavior_peekHeight="280dp" app:behavior_skipCollapsed="false">
        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" />
        <androidx.core.widget.NestedScrollView android:id="@+id/placeScroll"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:fillViewport="true" android:clipToPadding="false">
            <LinearLayout android:id="@+id/placeContent" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:paddingHorizontal="@dimen/cook_spacing_20" android:paddingBottom="@dimen/cook_spacing_24" />
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>

<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/cook_spacing_4"
    app:cardBackgroundColor="@color/cook_layer_raised"
    app:cardCornerRadius="@dimen/cook_radius_2xlarge"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/recipeImage"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cook_recipe_tile_size"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/recipeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/cook_spacing_12"
            android:layout_marginTop="@dimen/cook_spacing_12"
            android:layout_marginEnd="@dimen/cook_spacing_12"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.CookPilot.TitleS"
            android:textColor="@color/cook_text_primary" />

        <TextView
            android:id="@+id/recipeMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/cook_spacing_12"
            android:layout_marginTop="@dimen/cook_spacing_8"
            android:layout_marginEnd="@dimen/cook_spacing_12"
            android:textAppearance="@style/TextAppearance.CookPilot.LabelSmall"
            android:textColor="@color/cook_primary" />

        <TextView
            android:id="@+id/recipeServings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/cook_spacing_12"
            android:layout_marginTop="@dimen/cook_spacing_4"
            android:layout_marginEnd="@dimen/cook_spacing_12"
            android:layout_marginBottom="@dimen/cook_spacing_12"
            android:textAppearance="@style/TextAppearance.CookPilot.Caption"
            android:textColor="@color/cook_text_tertiary" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="188dp"
    android:layout_height="76dp"
    app:cardBackgroundColor="@color/cook_dark_glass_fill"
    app:cardCornerRadius="@dimen/cook_radius_3xxlarge"
    app:cardElevation="6dp"
    app:strokeColor="@color/cook_dark_glass_rim"
    app:strokeWidth="@dimen/cook_border_1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/cook_spacing_16"
        android:paddingVertical="@dimen/cook_spacing_12">

        <ImageView
            android:id="@+id/timerControlIcon"
            android:layout_width="@dimen/cook_icon_32"
            android:layout_height="@dimen/cook_icon_32"
            android:contentDescription="@string/cooking_timer_pause"
            android:padding="@dimen/cook_spacing_4" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/cook_spacing_8"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/timerRemaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit_medium"
                android:textAppearance="@style/TextAppearance.CookPilot.Label"
                android:textColor="@color/cook_text_primary" />

            <TextView
                android:id="@+id/timerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cook_spacing_4"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.CookPilot.LabelSmall"
                android:textColor="@color/cook_text_primary" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

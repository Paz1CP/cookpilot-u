<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/cook_touch_48"
        android:layout_marginHorizontal="@dimen/cook_padding_screen_x"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/mealMomentIcon"
            android:layout_width="@dimen/cook_icon_32"
            android:layout_height="@dimen/cook_icon_32"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/mealMomentTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/cook_spacing_16"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.CookPilot.TitleL"
            android:textColor="@color/cook_text_primary" />

        <ImageView
            android:id="@+id/mealMomentMoreIcon"
            android:layout_width="@dimen/cook_icon_24"
            android:layout_height="@dimen/cook_icon_24"
            android:contentDescription="@null"
            app:tint="@color/cook_text_primary" />

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/cook_spacing_16"
        android:layout_marginTop="@dimen/cook_spacing_16"
        android:layout_marginEnd="@dimen/cook_spacing_16"
        app:cardBackgroundColor="@color/cook_layer_raised"
        app:cardCornerRadius="@dimen/cook_radius_3xxlarge"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/cook_padding_card">

            <TextView
                android:id="@+id/mealPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S/ —"
                android:textAppearance="@style/TextAppearance.CookPilot.HighlightXL"
                android:textColor="@color/cook_primary" />

            <TextView
                android:id="@+id/mealMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cook_spacing_4"
                android:textAppearance="@style/TextAppearance.CookPilot.BodySmall"
                android:textColor="@color/cook_text_tertiary" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cook_spacing_20"
                android:clipToPadding="false"
                android:fillViewport="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/recipeRail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/ingredientsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cook_spacing_20"
                android:orientation="vertical"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/cook_touch_56"
                android:layout_marginTop="@dimen/cook_spacing_20"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ingredientsButton"
                    style="@style/Widget.CookPilot.Button.Secondary"
                    android:layout_width="@dimen/cook_touch_56"
                    android:layout_height="@dimen/cook_touch_56"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text=""
                    android:visibility="gone"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/cook_text_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/addRecipeButton"
                    style="@style/Widget.CookPilot.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/cook_touch_56"
                    android:layout_marginStart="@dimen/cook_spacing_12"
                    android:layout_weight="1"
                    android:text=""
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/cook_text_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cookButton"
                    style="@style/Widget.CookPilot.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/cook_touch_56"
                    android:layout_marginStart="@dimen/cook_spacing_12"
                    android:minWidth="124dp"
                    android:text="@string/cookplan_cook"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
